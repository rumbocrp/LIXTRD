{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sistema-luces/event-envelope-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at_utc",
    "received_at_utc",
    "source",
    "environment",
    "instrument",
    "correlation_id",
    "payload_hash",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "event_type": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at_utc": { "type": "string", "format": "date-time" },
    "received_at_utc": { "type": "string", "format": "date-time" },
    "persisted_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "source": {
      "type": "string",
      "enum": ["replay", "yahoo_finance", "ctrader_demo", "broker_demo_import", "journal_import", "simulator", "system", "operator"]
    },
    "environment": {
      "type": "string",
      "enum": ["NO_DATA", "SINTETICO", "REPLAY", "SHADOW", "DEMO_OBSERVADO", "BROKER_DEMO_OBSERVED"]
    },
    "source_account_id_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "instrument": { "type": "string", "const": "US500" },
    "symbol_id": { "type": ["string", "null"] },
    "source_sequence": { "type": ["integer", "null"], "minimum": 0 },
    "correlation_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "causation_id": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F-]{36}$" },
    "payload_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "previous_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "payload": { "type": "object" }
  }
}
