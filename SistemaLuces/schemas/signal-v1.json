{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sistema-luces/signal-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "case_id",
    "created_at_utc",
    "valid_until_utc",
    "environment",
    "instrument",
    "decision_window",
    "market_event_cutoff",
    "reference_bid",
    "reference_ask",
    "price_scale",
    "direction",
    "light",
    "reason_codes",
    "health_state",
    "safety_forced",
    "strategy_id",
    "strategy_version",
    "feature_set_version",
    "feature_snapshot_hash",
    "policy_version",
    "correlation_id",
    "code_hash",
    "schema_version"
  ],
  "properties": {
    "signal_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "case_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "valid_until_utc": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "string",
      "enum": ["NO_DATA", "SINTETICO", "REPLAY", "SHADOW", "DEMO_OBSERVADO", "BROKER_DEMO_OBSERVED"]
    },
    "instrument": { "type": "string", "const": "US500" },
    "decision_window": { "type": "string", "enum": ["S30", "S60"] },
    "market_event_cutoff": { "type": "string", "format": "date-time" },
    "reference_bid": { "type": "integer", "minimum": 1 },
    "reference_ask": { "type": "integer", "minimum": 1 },
    "price_scale": { "type": "integer", "minimum": 1 },
    "data_age_ms": { "type": ["integer", "null"], "minimum": 0 },
    "direction": { "type": "string", "enum": ["LONG", "SHORT", "MONITOR"] },
    "light": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "health_state": { "type": "string" },
    "safety_forced": { "type": "boolean" },
    "strategy_id": { "type": "string" },
    "strategy_version": { "type": "string" },
    "feature_set_version": { "type": "string" },
    "feature_snapshot_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "model_id": { "type": ["string", "null"] },
    "model_version": { "type": ["string", "null"] },
    "model_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "calibration_version": { "type": ["string", "null"] },
    "policy_version": { "type": "string" },
    "raw_score_long": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "raw_score_short": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "calibrated_probability_long": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "calibrated_probability_short": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "expected_value_long_net": { "type": ["integer", "null"] },
    "expected_value_short_net": { "type": ["integer", "null"] },
    "cost_profile_version": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "causation_id": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F-]{36}$" },
    "code_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "schema_version": { "type": "integer", "const": 1 }
  }
}
