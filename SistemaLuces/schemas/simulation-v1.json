{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sistema-luces/simulation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulation_id",
    "signal_id",
    "environment",
    "status",
    "proposed_at_utc",
    "direction",
    "planned_entry",
    "stop",
    "target",
    "risk_profile_version",
    "instrument_profile_version",
    "requested_quantity_simulated",
    "effective_quantity_simulated",
    "quantity_scale",
    "fill_source",
    "source_execution_ids",
    "money_scale",
    "currency",
    "reconciliation_status",
    "reconciliation_reason_codes",
    "market_event_cutoff",
    "correlation_id",
    "schema_version"
  ],
  "properties": {
    "simulation_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "signal_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "environment": {
      "type": "string",
      "enum": ["NO_DATA", "SINTETICO", "REPLAY", "SHADOW", "DEMO_OBSERVADO", "BROKER_DEMO_OBSERVED"]
    },
    "demo_account_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "OPEN_SIMULATED", "CLOSED_SIMULATED", "REJECTED", "CANCELLED"]
    },
    "proposed_at_utc": { "type": "string", "format": "date-time" },
    "opened_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "closed_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "horizon_end_utc": { "type": ["string", "null"], "format": "date-time" },
    "direction": { "type": "string", "enum": ["LONG", "SHORT"] },
    "planned_entry": { "type": "integer", "minimum": 1 },
    "stop": { "type": "integer", "minimum": 1 },
    "target": { "type": "integer", "minimum": 1 },
    "risk_profile_version": { "type": "string" },
    "instrument_profile_version": { "type": "string" },
    "requested_quantity_simulated": { "type": "integer", "minimum": 1 },
    "effective_quantity_simulated": { "type": "integer", "minimum": 0 },
    "quantity_scale": { "type": "integer", "minimum": 1 },
    "fill_entry": { "type": ["integer", "null"], "minimum": 1 },
    "fill_exit": { "type": ["integer", "null"], "minimum": 1 },
    "fill_source": { "type": "string", "enum": ["simulator", "broker_demo_import"] },
    "source_execution_ids": { "type": "array", "items": { "type": "string" } },
    "spread_cost": { "type": ["integer", "null"], "minimum": 0 },
    "slippage_cost": { "type": ["integer", "null"], "minimum": 0 },
    "commission_cost": { "type": ["integer", "null"], "minimum": 0 },
    "carry_cost": { "type": ["integer", "null"], "minimum": 0 },
    "money_scale": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string" },
    "exit_reason": {
      "type": ["string", "null"],
      "enum": ["stop", "target", "time", "manual_demo", "risk_limit", "invalid_data", null]
    },
    "gross_pnl": { "type": ["integer", "null"] },
    "net_pnl": { "type": ["integer", "null"] },
    "realized_r": { "type": ["integer", "null"] },
    "mfe": { "type": ["integer", "null"] },
    "mae": { "type": ["integer", "null"] },
    "reconciliation_status": {
      "type": "string",
      "enum": ["PENDING", "MATCHED", "PARTIAL", "UNMATCHED", "INVALID"]
    },
    "reconciliation_reason_codes": { "type": "array", "items": { "type": "string" } },
    "market_event_cutoff": { "type": "string", "format": "date-time" },
    "cost_profile_version": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "causation_id": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F-]{36}$" },
    "schema_version": { "type": "integer", "const": 1 }
  }
}
